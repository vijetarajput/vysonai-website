# Server-only. Never prefix these with NEXT_PUBLIC_.
# Used only by POST /api/lead.

RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
EMAIL_FROM=

# Leads from the demo form are also delivered to this Telegram chat.
# Create a bot with @BotFather for the token; the chat ID is your chat (or group) with that bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: also send each lead to an n8n webhook.
N8N_WEBHOOK_URL=

# Optional. If set, it is sent as the "x-webhook-secret" header so your n8n webhook can reject other callers.
N8N_WEBHOOK_SECRET=
