# Server-only. Never prefix these with NEXT_PUBLIC_.
# Used only by POST /api/lead.

RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# Optional: also send each lead to an n8n webhook.
N8N_WEBHOOK_URL=

# Optional. If set, it is sent as the "x-webhook-secret" header so your n8n webhook can reject other callers.
N8N_WEBHOOK_SECRET=
